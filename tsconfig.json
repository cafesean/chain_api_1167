{
	"extends": "fastify-tsconfig",
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@contracts/*": ["contracts/*"],
			"@utils/*": ["utils/*"],
			"@constants/*": ["constants/*"],
		},
		"allowJs": true,
		"declaration": false,
		"outDir": "dist",
		"target": "es2020",
		"esModuleInterop": true,
		"moduleResolution": "node",
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": false,
		"skipLibCheck": true
	},
	"include": ["*.ts", "src/**/*.ts", "src/*.ts", "src/*.js", "src/contracts/**/*.*"],
}
