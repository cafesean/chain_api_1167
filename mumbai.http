### Step 1 deploy new contracts (for cloning)
POST http://localhost:4000/contract/deploy HTTP/1.1
Content-Type: 'application/json'

{
    "name": "None"
}

### Step 2 deploy factory

POST http://localhost:4000/contract/deployFactory HTTP/1.1
Content-Type: 'application/json'

{
    "name": "-",
    "proxy_address": "0x0e2968e9C369af6E9C162F897927C83dB209950C"
}

### Step 3 clone

POST http://localhost:4000/contract/clone HTTP/1.1
Content-Type: 'application/json'

{
    "org_id": 2,
    "uuid": "1234",
    "name": "Certified Developers",
    "baseUri": "http://localhost:3000/api/media/",
    "factory_address": "0x6C0729241c61538eC37f308355Dee97890eC82b7",
    "contract_address": "0x0e2968e9C369af6E9C162F897927C83dB209950C",
    "delegate_address": "0x7C9fD0c8Bd6900bedD517f672d7Ba7d0b5539757",
    "description": "Certified Developer",
    "image_url": "clone-16.png",
    "slug": "certified-developer",
    "requirements": "User must hold a Member NFT.",
    "attributes": {
        "year": 2023
    }
}

### Step 4a addClass (contract)
POST http://localhost:4000/contract/0xc6D217F553538FfD803a748a1C88A57E325A9718/class HTTP/1.1
Content-Type: 'application/json'

{
    "series_id": 139,
    "name": "Level 1",
    "title": "Level 1",
    "desc": "Certified Developer Level 1",
    "image_url": "https://chainxp.sgp1.digitaloceanspaces.com/prod/template/xp-template-1.gif",
    "slug": "level-1",
    "template": "0x606C23c800349C7bA63b76945F5B5a9F23D15225"
}

