{
	"name": "token",
	"version": "2.0.0",
	"description": "Lambda function generated by Amplify",
	"main": "index.js",
	"license": "Apache-2.0",
	"scripts": {
		"amplify:token": "cd amplify/backend/function/token && tsc -p ./tsconfig.json && cd -",
		"build": "tsc --build tsconfig.json && prisma generate",
		"clean": "rm -rf dist",
		"compile": "tsup src/*.ts src/**/*.ts --out-dir dist/src && cp -r prisma dist/prisma && cp -r contracts dist/contracts",
		"deploy": "rm -rf dist && amplify push",
		"test": "echo \"Error: no test specified\" && exit 1",
		"start": "if-env NODE_ENV=production ?? pnpm start:prod || pnpm dev",
		"dev": "tsx watch src/app.ts",
		"start:prod": "node dist/src/app.js",
		"typecheck": "tsc -b",
		"layer": "rm -rf layer/nodejs/*.* && cp -L -r node_modules layer/nodejs",
		"gen": "prisma generate",
		"push": "prisma db push",
		"pull": "prisma db"
	},
	"dependencies": {
		"@ethersproject/bytes": "^5.7.0",
		"@fastify/autoload": "^5.7.1",
		"@fastify/aws-lambda": "^3.3.0",
		"@lukeed/ms": "^2.0.1",
		"@openzeppelin/contracts": "^4.9.3",
		"@openzeppelin/contracts-upgradeable": "^4.9.3",
		"@prisma/client": "^5.1.1",
		"OwnableUpgradeable.sol": "link:@openzeppelin/contracts-upgradeable/access/OwnableUpgradeable.sol",
		"ProxyFactory.sol": "link:@openzeppelin/upgrades/contracts/upgradeability/ProxyFactory.sol",
		"alchemy-sdk": "^2.9.2",
		"axios": "^1.4.0",
		"dotenv": "^16.3.1",
		"ethers": "^5.7.2",
		"fastify": "^4.21.0",
		"fastify-plugin": "^4.5.1",
		"fastify-prisma-client": "^5.0.0",
		"hardhat": "^2.17.1",
		"http-status-codes": "^2.2.0",
		"path": "^0.12.7",
		"runtime": "link:@prisma/client/runtime",
		"tsup": "^6.7.0"
	},
	"devDependencies": {
		"@ethersproject/abi": "^5.7.0",
		"@ethersproject/providers": "^5.7.2",
		"@fastify/autoload": "^5.4.1",
		"@fastify/cors": "^8.3.0",
		"@fastify/helmet": "^10.1.1",
		"@fastify/jwt": "^6.7.1",
		"@fastify/multipart": "^7.7.3",
		"@fastify/swagger": "^8.8.0",
		"@fastify/swagger-ui": "^1.9.3",
		"@nomicfoundation/hardhat-network-helpers": "^1.0.8",
		"@nomiclabs/hardhat-ethers": "^2.2.3",
		"@nomiclabs/hardhat-etherscan": "^3.1.7",
		"@typechain/ethers-v5": "^10.2.1",
		"@typechain/hardhat": "^6.1.6",
		"@types/node": "^18.17.4",
		"OwnableUpgradeable.sol": "link:@openzeppelin/contracts-upgradeable/access/OwnableUpgradeable.sol",
		"ProxyFactory.sol": "link:@openzeppelin/upgrades/contracts/upgradeability/ProxyFactory.sol",
