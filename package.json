{
  "name": "token",
  "version": "2.0.0",
  "description": "Lambda function generated by Amplify",
  "main": "index.js",
  "license": "Apache-2.0",
  "scripts": {
    "amplify:token": "cd amplify/backend/function/token && tsc -p ./tsconfig.json && cd -",
    "clean": "rm -rf src",
    "compile": "tsc",
    "build": "npm run clean && npm run compile",
    "deploy": "rm -rf dist && amplify push",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node dev/app.ts",
    "dev": "yarn start:dev",
    "start:build": "node src/app.js",
    "start:dev": "tsx watch dev/app.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fastify/autoload": "^5.6.0",
    "@fastify/aws-lambda": "^3.1.3",
    "dotenv": "^16.0.3",
    "ethers": "^5.7.2",
    "fastify": "^4.10.2",
    "fastify-plugin": "^4.3.0",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@types/node": "^18.11.9",
    "fastify-tsconfig": "^1.0.1",
    "path": "^0.12.7",
    "ts-node": "^10.9.1",
    "tsx": "^3.12.1",
    "typescript": "4.9.3"
  }
}
