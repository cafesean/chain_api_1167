{
	"name": "token",
	"version": "2.0.0",
	"description": "Lambda function generated by Amplify",
	"main": "index.js",
	"license": "Apache-2.0",
	"scripts": {
		"amplify:token": "cd amplify/backend/function/token && tsc -p ./tsconfig.json && cd -",
		"build": "pnpm compile && pnpm typecheck",
		"clean": "rm -rf src",
		"compile": "tsup dev/*.ts dev/**/*.ts --out-dir src",
		"deploy": "rm -rf dist && amplify push",
		"test": "echo \"Error: no test specified\" && exit 1",
		"start": "pnpm dev/app.ts",
		"dev": "pnpm start:dev",
		"start:build": "node src/dev/app.cjs",
		"start:dev": "tsx watch dev/app.ts",
		"typecheck": "tsc -b"
	},
